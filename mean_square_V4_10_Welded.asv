%% =========================================================
%  Evaluation ponctuelle du facteur d'imperfection alpha - Eurocode 3
%  chi = 1 / (Phi + sqrt(Phi^2 - lambda^2))     avec chi <= 1
%  Phi = 0.5 * [1 + alpha*(lambda - 0.2) + lambda^2]
%
%  PAS D'OPTIMISATION ICI : alpha est fixe a la main ci-dessous
%  (p et lambda0 restent fixes aussi, valeurs EC3 classiques).
%
%  Legende par nuance d'acier deduite de l'ID (colonne B) :
%     M-1-... => S690
%     M-2-... => S460
%     M-3-... => S355
%  =========================================================
clear; clc; close all;


%% --- 1. DONNEES EXPERIMENTALES (lues depuis Excel) ---

fichier_excel = 'Result_new - version 3.xlsm';
feuille       = 'Welded shape';
finn = 56;
range_id     = sprintf('M3:M%d', finn);    % <-- ID de l'element (ex: M-1-I-1-1)
range_lambda    = sprintf('N3:N%d', finn);
range_chi = sprintf('O3:O%d', finn);

id_brut     = readcell(fichier_excel, 'Sheet', feuille, 'Range', range_id);
lambda_brut = readmatrix(fichier_excel, 'Sheet', feuille, 'Range', range_lambda);
chi_brut    = readmatrix(fichier_excel, 'Sheet', feuille, 'Range', range_chi);

% Retrait des lignes vides (NaN en lambda ou chi), id/lambda/chi retires ensemble
[lambda_data, chi_data, id_data] = nettoyer_triplet(lambda_brut, chi_brut, id_brut);

% lambda_data et chi_data en vecteurs ligne (coherent avec le reste du script)
lambda_data = lambda_data(:)';
chi_data    = chi_data(:)';

assert(length(lambda_data) == length(chi_data), ...
    'Erreur : lambda_data et chi_data doivent avoir la meme longueur.');
assert(length(lambda_data) == length(id_data), ...
    'Erreur : id_data doit avoir la meme longueur que lambda_data.');

% --- Deduction de la nuance a partir de l'ID ---
nuance_data = cellfun(@obtenir_nuance, id_data, 'UniformOutput', false);

% Index logiques par nuance (pour le trace et les stats)
idx_S690 = strcmp(nuance_data, 'S690');   % M-1
idx_S460 = strcmp(nuance_data, 'S460');   % M-2
idx_S355 = strcmp(nuance_data, 'S355');   % M-3


%% --- 2. VALEUR A TESTER MANUELLEMENT ---
% <-- Modifiez alpha_test pour explorer differentes valeurs.

alpha_test   = 0.3;   % <-- alpha a evaluer (plus de calibration automatique)
p_fixe       = 2;      % <-- expose fixe
lambda0_fixe = 0.3;    % <-- lambda0 fixe (valeur EC3 classique)


%% --- 3. MODELE ---

phi_fun = @(alpha, lam) 0.5 .* (1 + alpha .* (lam - lambda0_fixe) + lam.^p_fixe);

chi_fun = @(alpha, lam) min(1.0, ...
    1 ./ (phi_fun(alpha, lam) + sqrt(max(0, phi_fun(alpha, lam).^2 - lam.^p_fixe))));


%% --- 4. EVALUATION PONCTUELLE (pas d'optimisation, alpha_test fixe) ---

chi_fit   = chi_fun(alpha_test, lambda_data);
residuals = chi_data - chi_fit;
SSres     = sum(residuals.^2);
SStot     = sum((chi_data - mean(chi_data)).^2);
R2        = 1 - SSres / SStot;
RMSE      = sqrt(mean(residuals.^2));
MAE       = mean(abs(residuals));


%% --- 4bis. ANALYSE DU RATIO chi_fit / chi_data ---
% Objectif : verifier si le modele est plutot conservateur (ratio < 1,
% donc chi_fit < chi_data) ou non-conservateur (ratio > 1).

ratio = chi_fit ./ chi_data;

stats_all  = calculer_stats_ratio(ratio);
stats_S690 = calculer_stats_ratio(ratio(idx_S690));
stats_S460 = calculer_stats_ratio(ratio(idx_S460));
stats_S355 = calculer_stats_ratio(ratio(idx_S355));

afficher_stats_ratio('Ensemble (toutes nuances)', stats_all);
afficher_stats_ratio('S690 (M-1)', stats_S690);
afficher_stats_ratio('S460 (M-2)', stats_S460);
afficher_stats_ratio('S355 (M-3)', stats_S355);


%% --- 5. RESUME CONSOLE ---

fprintf('\n==========================================\n');
fprintf('  EVALUATION PONCTUELLE (pas de calibration)\n');
fprintf('==========================================\n');
fprintf('  alpha teste : %.4f\n', alpha_test);
fprintf('  lambda0     : %.4f  (fixe)\n', lambda0_fixe);
fprintf('  p           : %.4f  (fixe)\n', p_fixe);
fprintf('  R2          : %.6f\n', R2);
fprintf('  RMSE        : %.6f\n', RMSE);
fprintf('  MAE         : %.6f\n', MAE);
fprintf('  Nb points   : %d  (S690: %d, S460: %d, S355: %d)\n', ...
    length(lambda_data), sum(idx_S690), sum(idx_S460), sum(idx_S355));
fprintf('==========================================\n\n');


%% --- 6. FIGURE : donnees experimentales par nuance + courbe testee ---

lam_plot     = linspace(0, max(lambda_data) * 1.1, 400);
chi_plot_test = chi_fun(alpha_test, lam_plot);
chi_plot_test(1) = 1;   % verrou numerique : chi(lambda=0) = 1

% --- Palette par nuance ---
couleur_S355 = [0.850 0.325 0.098];   % orange
couleur_S460 = [0.580 0.000 0.827];   % violet
couleur_S690 = [0.000 0.600 0.200];   % vert

figure('Color', 'white', 'Position', [100 100 720 520]);
ax = axes; hold(ax, 'on'); grid(ax, 'on');

% Points experimentaux, colores et marques par nuance
scatter(ax, lambda_data(idx_S690), chi_data(idx_S690), 40, couleur_S690, 'filled', 's', ...
    'MarkerEdgeColor', 'black', 'LineWidth', 0.6, 'DisplayName', 'S690');

scatter(ax, lambda_data(idx_S460), chi_data(idx_S460), 40, couleur_S460, 'filled', 's', ...
    'MarkerEdgeColor', 'black', 'LineWidth', 0.6, 'DisplayName', 'S460');

scatter(ax, lambda_data(idx_S355), chi_data(idx_S355), 40, couleur_S355, 'filled', 's', ...
    'MarkerEdgeColor', 'black', 'LineWidth', 0.6, 'DisplayName', 'S355');

% Courbe testee
plot(ax, lam_plot, chi_plot_test, '-', ...
    'Color', [0.1 0.1 0.1], 'LineWidth', 2.2, ...
    'DisplayName', sprintf('O.I.C. member buckling curve : \\alpha=%.2f', alpha_test));

xlabel(ax, '$\bar{\lambda}_G$', 'Interpreter', 'latex', 'FontSize', 16, 'Color', 'black');
ylabel(ax, '$\chi$', 'Interpreter', 'latex', 'FontSize', 16, 'Color', 'black');
title(ax, 'Welded member buckling curve', ...
    'FontSize', 13, 'FontWeight', 'bold', 'Color', 'black');
xlim(ax, [0, max(lam_plot)]);
ylim(ax, [0, 1.15]);
legend(ax, 'Location', 'northeast', 'TextColor', 'black', 'EdgeColor', 'black', 'Color', 'white');

set(ax, 'Box', 'on', ...
    'Color', 'white', ...
    'XColor', 'black', ...
    'YColor', 'black', ...
    'GridColor', [0 0 0]);


%% --- FONCTIONS LOCALES ---

function [lambda_propre, chi_propre, id_propre] = nettoyer_triplet(lambda_brut, chi_brut, id_brut)
    % Retire les lignes ou lambda ou chi est NaN, en gardant id_brut aligne
    lambda_brut = lambda_brut(:);
    chi_brut    = chi_brut(:);
    id_brut     = id_brut(:);

    valide        = ~isnan(lambda_brut) & ~isnan(chi_brut);
    lambda_propre = lambda_brut(valide);
    chi_propre    = chi_brut(valide);
    id_propre     = id_brut(valide);
end

function nuance = obtenir_nuance(id_cell)
    % Determine la nuance d'acier a partir du prefixe de l'ID (M-1/M-2/M-3)
    id_str = string(id_cell);
    if startsWith(id_str, 'M-1')
        nuance = 'S690';
    elseif startsWith(id_str, 'M-2')
        nuance = 'S460';
    elseif startsWith(id_str, 'M-3')
        nuance = 'S355';
    else
        nuance = 'Inconnu';
    end
end

function stats = calculer_stats_ratio(ratio)
    % Calcule les statistiques descriptives du ratio chi_fit/chi_data
    stats.n        = numel(ratio);
    stats.mean     = mean(ratio);
    stats.std      = std(ratio);
    stats.cov      = stats.std / stats.mean;   % coefficient de variation
    stats.min      = min(ratio);
    stats.max      = max(ratio);

    % Compteurs "au-dessus de" (modele non conservateur)
    stats.n_gt_1_00  = sum(ratio > 1.00);
    stats.n_gt_1_03  = sum(ratio > 1.03);
    stats.n_gt_1_10  = sum(ratio > 1.10);
    stats.n_gt_1_25  = sum(ratio > 1.25);

    % Compteurs "en-dessous de" (modele conservateur)
    stats.n_lt_0_95  = sum(ratio < 0.95);
    stats.n_lt_0_90  = sum(ratio < 0.90);
    stats.n_lt_0_75  = sum(ratio < 0.75);
end

function afficher_stats_ratio(nom, stats)
    fprintf('\n------------------------------------------\n');
    fprintf('  RATIO chi_fit / chi_data : %s\n', nom);
    fprintf('------------------------------------------\n');
    fprintf('  Nb points     : %d\n',   stats.n);
    fprintf('  Moyenne       : %.4f\n', stats.mean);
    fprintf('  Ecart-type    : %.4f\n', stats.std);
    fprintf('  CoV           : %.4f  (%.2f %%)\n', stats.cov, stats.cov*100);
    fprintf('  Min           : %.4f\n', stats.min);
    fprintf('  Max           : %.4f\n', stats.max);
    fprintf('  --- Ratios superieurs a ---\n');
    fprintf('  > 1.00        : %d  (%.1f %%)\n', stats.n_gt_1_00, 100*stats.n_gt_1_00/stats.n);
    fprintf('  > 1.03        : %d  (%.1f %%)\n', stats.n_gt_1_03, 100*stats.n_gt_1_03/stats.n);
    fprintf('  > 1.10        : %d  (%.1f %%)\n', stats.n_gt_1_10, 100*stats.n_gt_1_10/stats.n);
    fprintf('  > 1.25        : %d  (%.1f %%)\n', stats.n_gt_1_25, 100*stats.n_gt_1_25/stats.n);
    fprintf('  --- Ratios inferieurs a ---\n');
    fprintf('  < 0.95        : %d  (%.1f %%)\n', stats.n_lt_0_95, 100*stats.n_lt_0_95/stats.n);
    fprintf('  < 0.90        : %d  (%.1f %%)\n', stats.n_lt_0_90, 100*stats.n_lt_0_90/stats.n);
    fprintf('  < 0.75        : %d  (%.1f %%)\n', stats.n_lt_0_75, 100*stats.n_lt_0_75/stats.n);
end